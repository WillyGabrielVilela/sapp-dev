# Copie para .env (ou configure no servidor/contêiner). NUNCA versione o .env.

# --- Banco (qualquer PostgreSQL 13+: Neon, RDS, servidor da ATI-PE) ---
DATABASE_URL=postgres://usuario:senha@host:5432/sapp
# DATABASE_POOL_MAX=10
# Só se o servidor usar certificado de CA interna (ex.: ATI). Prefira instalar a CA no servidor:
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# --- Arquivos originais (PDF do JR5260) ---
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./armazenamento
# S3 (AWS ou compatível, p.ex. MinIO). Sem chaves, vale o papel IAM do ambiente (recomendado na AWS).
# S3_BUCKET=
# S3_REGION=sa-east-1
# S3_ENDPOINT=                  # só para S3 compatível (MinIO etc.)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Acesso ---
# Cadastro por conta própria: o primeiro usuário sempre pode se cadastrar (vira administrador).
# Depois disso só com PERMITIR_CADASTRO=true; o normal é o administrador criar as contas.
PERMITIR_CADASTRO=false
SESSAO_HORAS=12
# Cookie só trafega em HTTPS por padrão em produção. Use false apenas em teste local sem HTTPS.
# COOKIE_SECURE=false

# TESTE DO FLUXO: mostra o botão "vencer o prazo". Deixe false (ou ausente) em produção.
MODO_TESTE=false

PORT=3000
